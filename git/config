[init]
    defaultBranch = master

[branch "master"]
    remote = origin
    merge = refs/heads/master

[branch "main"]
    remote = origin
    merge = refs/heads/main

# pulls all remote prs as local branches
[remote "origin"]
    fetch = +refs/pull/*/head:refs/remotes/origin/pr/*

[remote "upstream"]
    fetch = +refs/pull/*/head:refs/remotes/upstream/pr/*

[column]
    ui = auto

[branch]
    sort = -committerdate

[tag]
    sort = -version:refname

[rerere]
    enabled = true
    autoupdate = true

# Start other core configuration
[alias]
    ll = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
    lls = !git ll --stat
    mff = merge --no-ff --log
    last = log -1 HEAD --stat --relative-date
    new = log master..origin/master --stat
    squash = merge --squash --no-commit
    credit = commit --amend --author "$1 <$2>" -C HEAD
    fuckit = reset --hard HEAD
    unstage = reset HEAD --
    subupdate = submodule foreach git fetch origin
    exportfiles = !sh -c 'git diff $0 --name-only | "while read files; do mkdir -p \"$1/$(dirname $files)\"; cp -vf $files $1/$(dirname $files); done"'
    rmerge = !git checkout -b $1 origin/$1 && git checkout ${2:-master} && git merge --no-ff $1 && git branch -D $1

[color]
    ui = yes

[core]
    autocrlf = input
    excludesfile = ~/.config/git/ignore
    editor = nvim

[merge]
    conflictstyle = diff3

[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true

[rebase]
    stat = yes
    autostash = true

[push]
    default = simple
    autoSetupRemote = true

[filter "media"]
    required = true
    clean = git media clean %f
    smudge = git media smudge %f

[filter "lfs"]
    required = true
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process

[commit]
    verbose = true
#     gpgsign = true

[credential]
    helper = osxkeychain

[pull]
    rebase = true

# github
[credential "https://github.com"]
    helper = 
    helper = !/opt/homebrew/bin/gh auth git-credential

[credential "https://gist.github.com"]
    helper = 
    helper = !/opt/homebrew/bin/gh auth git-credential

[url "git@github.com"]
    insteadOf = gh

